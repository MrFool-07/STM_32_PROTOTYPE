                    <span class="text-[9px] font-mono text-slate-400">TIM3_CH1..3</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center py-1">
                    <div
                        class="p-2 rounded-lg bg-slate-950 border border-slate-800 flex flex-col items-center justify-center">
                        <div id="led-normal" class="w-4 h-4 rounded-full led-off mb-1 transition-all"></div>
                        <span class="text-[9px] font-mono text-emerald-400 font-bold">NORMAL</span>

                        <span class="text-[8px] font-mono text-slate-400 mt-0.5">DOWN</span>
                    </button>
                    <button onclick="handleKeypadAction('select')" id="btn-select"
                        class="btn-keypad py-2 rounded-lg text-emerald-400 text-xs font-bold flex flex-col items-center justify-center border-b-2 border-emerald-500">
                        <i class="fa-solid fa-check"></i>
                        <span class="text-[8px] font-mono text-emerald-400 mt-0.5">SELECT</span>
                    </button>
                    <button onclick="handleKeypadAction('back')" id="btn-back"
                        class="btn-keypad py-2 rounded-lg text-blue-400 text-xs font-bold flex flex-col items-center justify-center">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span class="text-[8px] font-mono text-blue-400 mt-0.5">BACK</span>
                    </button>
                    <button onclick="triggerSystemReboot()" id="btn-reset"
                        class="btn-keypad py-2 rounded-lg text-red-400 text-xs font-bold flex flex-col items-center justify-center border-b-2 border-red-500">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span class="text-[8px] font-mono text-red-400 mt-0.5">RESET</span>
                    </button>

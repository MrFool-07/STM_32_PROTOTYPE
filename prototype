                    <span id="screen-app-tag" class="hidden text-amber-400 font-bold"></span>
                </div>
                <div class="flex items-center space-x-3 text-slate-300 text-[11px]">
                    <span class="flex items-center gap-1 font-bold text-slate-200"><i
                            class="fa-solid fa-clock text-amber-400"></i> <span id="rtc-clock">2026-10-16

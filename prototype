        // Update PWM Status LEDs
        function updatePWMDiagnosticLEDs(health) {
            const ledNorm = document.getElementById('led-normal');
            const ledAnom = document.getElementById('led-anomaly');
            const ledCrit = document.getElementById('led-critical');

            if (!ledNorm || !ledAnom || !ledCrit) return;

            ledNorm.className = "w-4 h-4 rounded-full led-off mb-1 transition-all";
            ledAnom.className = "w-4 h-4 rounded-full led-off mb-1 transition-all";
            ledCrit.className = "w-4 h-4 rounded-full led-off mb-1 transition-all";

            if (health === 'NORMAL') {
                ledNorm.className = "w-4 h-4 rounded-full led-solid-green mb-1 transition-all";
            } else if (health === 'ANOMALY') {
                ledAnom.className = "w-4 h-4 rounded-full led-solid-yellow mb-1 transition-all";
            } else {
                ledCrit.className = "w-4 h-4 rounded-full led-solid-red mb-1 transition-all";
            }
        }

        // SD Card Safety Eject Behavior
        function handleSDEjectTrigger() {
            if (sensorTelemetry.sdState === 'SCANNING_WRITE') {
                // Ejected while SOLID RED -> Trigger Error Alarm Toast!
                sensorTelemetry.sdState = 'EJECTED';
                updateSDSlotVisuals();
                showToast("CRITICAL SD WRITE ERROR!", "Card ejected during active write cycle! Data corrupted.", "error");
                playBuzzerBeep(220, 0.4, 'sawtooth');

                setTimeout(() => {
                    sensorTelemetry.sdState = 'IDLE';
                    updateSDSlotVisuals();
                    showToast("SD Card Re-inserted", "FAT32 partition re-initialized.", "success");
                }, 3500);
            } else if (sensorTelemetry.sdState === 'EJECTED') {
                sensorTelemetry.sdState = 'IDLE';
                updateSDSlotVisuals();
                showToast("SD Card Inserted", "Ready for data logging.", "success");
            } else {
                sensorTelemetry.sdState = 'EJECTED';
                updateSDSlotVisuals();
                showToast("SD Card Safely Removed", "LED was Solid Green. Safe removal verified.", "info");
            }
        }

        function updateSDSlotVisuals() {
            const indicator = document.getElementById('sd-led-indicator');
            const statusText = document.getElementById('sd-status-text');

            if (!indicator || !statusText) return;

            if (sensorTelemetry.sdState === 'SCANNING_WRITE') {
                indicator.className = "w-3.5 h-3.5 rounded-full led-solid-red transition-all"; // Solid Red (Non-blinking)
                statusText.innerText = "SD: BUSY (SOLID RED)";
                statusText.className = "text-red-400 font-bold font-mono";
            } else if (sensorTelemetry.sdState === 'IDLE') {
                indicator.className = "w-3.5 h-3.5 rounded-full led-solid-green transition-all"; // Solid Green
                statusText.innerText = "SD: SAFE TO REMOVE";
                statusText.className = "text-emerald-400 font-bold font-mono";
            } else {
                indicator.className = "w-3.5 h-3.5 rounded-full led-off transition-all";
                statusText.innerText = "SD: EJECTED";
                statusText.className = "text-amber-400 font-bold font-mono";
            }
        }

        // Mode Switch Keypad Controls
        function handleKeypadAction(action) {
            playBuzzerBeep(880, 0.05);

            const btn = document.getElementById(`btn-${action}`);
            if (btn) {
                btn.classList.add('active-press');
                setTimeout(() => btn.classList.remove('active-press'), 120);
            }

            if (currentSystemState === 'app_select') {
                if (action === 'up') {
                    selectedAppIndex = (selectedAppIndex - 1 + availableApplications.length) % availableApplications.length;
                    renderAppSelectionUI();
                } else if (action === 'down') {
                    selectedAppIndex = (selectedAppIndex + 1) % availableApplications.length;
                    renderAppSelectionUI();
                } else if (action === 'select') {
                    renderModeSelectionMenu();
                } else if (action === 'back') {
                    triggerSystemReboot();
                }
            } else if (currentSystemState === 'mode_select') {
                if (action === 'up') {
                    selectedModeIndex = (selectedModeIndex - 1 + availableModes.length) % availableModes.length;
                    renderModeSelectionUI();
                } else if (action === 'down') {
                    selectedModeIndex = (selectedModeIndex + 1) % availableModes.length;
                    renderModeSelectionUI();
                } else if (action === 'select') {
                    startScanningAndLoggingSequence();
                } else if (action === 'back') {
                    renderAppSelectionMenu();
                }
            } else if (currentSystemState === 'live_monitor' || currentSystemState === 'diagnostic') {
                if (action === 'back') {
                    renderModeSelectionMenu();
                }
            }
        }
    </script>
</body>

</html>

        // Live Dynamic Telemetry Loop
        function startTelemetryLoop() {
            if (telemetryTimer) clearInterval(telemetryTimer);

            telemetryTimer = setInterval(() => {
                const tempSlider = document.getElementById('sim-temp-slider');
                const vibSlider = document.getElementById('sim-vib-slider');

                if (tempSlider && vibSlider) {
                    let tVal = parseFloat(tempSlider.value);
                    let vVal = parseFloat(vibSlider.value);

                    if (tVal > 80 || vVal > 6.0) {
                        systemHealthState = 'CRITICAL';
                    } else if (tVal > 60 || vVal > 3.0) {
                        systemHealthState = 'ANOMALY';
                    } else {
                        systemHealthState = 'NORMAL';
                    }

                    sensorTelemetry.temperature = tVal;
                    sensorTelemetry.vibrationRMS = vVal;
                    sensorTelemetry.humidity = +(50 + Math.sin(Date.now() / 1200) * 4).toFixed(1);

                    if (currentSystemState === 'live_monitor') {
                        const tempEl = document.getElementById('val-temp');
                        const humEl = document.getElementById('val-hum');
                        const vibEl = document.getElementById('val-vib');

                        if (tempEl) tempEl.innerText = `${sensorTelemetry.temperature}°C`;
                        if (humEl) humEl.innerText = `${sensorTelemetry.humidity}%`;
                        if (vibEl) vibEl.innerText = `${sensorTelemetry.vibrationRMS} mm/s`;

                        const dot = document.getElementById('health-dot');
                        const title = document.getElementById('health-title');
                        const desc = document.getElementById('health-desc');

                        if (systemHealthState === 'NORMAL') {
                            if (dot) dot.className = "w-3 h-3 rounded-full bg-emerald-400";
                            if (title) { title.className = "font-bold text-emerald-400"; title.innerText = "NORMAL OPERATION"; }
                            if (desc) desc.innerText = "All parameters within optimal thresholds.";
                        } else if (systemHealthState === 'ANOMALY') {
                            if (dot) dot.className = "w-3 h-3 rounded-full bg-amber-400";
                            if (title) { title.className = "font-bold text-amber-400"; title.innerText = "SUSPECTED ANOMALY"; }
                            if (desc) desc.innerText = "Elevated vibration detected in bearings.";
                        } else {
                            if (dot) dot.className = "w-3 h-3 rounded-full bg-red-400";
                            if (title) { title.className = "font-bold text-red-400"; title.innerText = "CRITICAL CONDITION"; }
                            if (desc) desc.innerText = "Thermal threshold exceeded! Stop equipment.";
                        }
                    }

                    updatePWMDiagnosticLEDs(systemHealthState);
                }
            }, 1000);
        }


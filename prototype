            return filtered.map(log => {
                let badgeClass = "bg-emerald-500/20 text-emerald-400 border-emerald-500/30";
                if (log.status === 'ANOMALY') badgeClass = "bg-amber-500/20 text-amber-400 border-amber-500/30";
                if (log.status === 'CRITICAL') badgeClass = "bg-red-500/20 text-red-400 border-red-500/30";


        </div>

        <!-- Live Sensor Simulation Tuner -->
        <div
            class="bg-slate-900/70 p-3 rounded-xl border border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
            <div class="flex items-center space-x-2 text-slate-300 font-bold">
                <i class="fa-solid fa-sliders text-amber-400"></i>
                <span>LIVE SENSOR SIMULATOR:</span>
            </div>
            <div class="flex flex-wrap items-center gap-4">
                <div class="flex items-center space-x-2 bg-slate-950 px-2.5 py-1 rounded border border-slate-800">
                    <span class="text-slate-400 text-[11px]">Temp:</span>
                    <input type="range" id="sim-temp-slider" min="20" max="110" value="42"
                        oninput="handleManualTelemetryTuning()" class="w-20 accent-amber-400 cursor-pointer">
                    <span id="sim-temp-val" class="text-amber-400 w-9 text-right font-bold">42°C</span>
                </div>
                <div class="flex items-center space-x-2 bg-slate-950 px-2.5 py-1 rounded border border-slate-800">
                    <span class="text-slate-400 text-[11px]">Vib RMS:</span>
                    <input type="range" id="sim-vib-slider" min="0.5" max="10.0" step="0.1" value="1.2"
                        oninput="handleManualTelemetryTuning()" class="w-20 accent-blue-400 cursor-pointer">
                    <span id="sim-vib-val" class="text-blue-400 w-12 text-right font-bold">1.2m/s</span>
                </div>
                <div class="flex items-center space-x-1.5">
                    <button onclick="setConditionPreset('NORMAL')"
                        class="px-2 py-1 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 rounded border border-emerald-500/40 text-[10px] font-bold">Preset
                        Normal</button>
                    <button onclick="setConditionPreset('ANOMALY')"
                        class="px-2 py-1 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 rounded border border-amber-500/40 text-[10px] font-bold">Preset
                        Anomaly</button>
                    <button onclick="setConditionPreset('CRITICAL')"
                        class="px-2 py-1 bg-red-500/20 hover:bg-red-500/30 text-red-300 rounded border border-red-500/40 text-[10px] font-bold">Preset
                        Critical</button>
                </div>
            </div>
        </div>

    </div>

    <!-- Application Script -->
    <script>
        // Web Audio API Buzzer Synthesizer
        let audioCtx = null;
        function playBuzzerBeep(freq = 880, duration = 0.08, type = 'sine') {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.warn('Buzzer audio disabled', e);
            }
        }

        // Custom Toast Alert
        function showToast(title, msg, type = 'info') {
            const toast = document.getElementById('toast-modal');
            const titleEl = document.getElementById('toast-title');
            const msgEl = document.getElementById('toast-msg');
            const iconEl = document.getElementById('toast-icon');
            const contentEl = document.getElementById('toast-content');

            titleEl.innerText = title;
            msgEl.innerText = msg;

            if (type === 'error') {
                contentEl.className = "bg-slate-900 border-2 border-red-500 text-slate-100 px-6 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3.5";
                iconEl.className = "fa-solid fa-triangle-exclamation text-red-500 text-2xl";
                playBuzzerBeep(240, 0.35, 'sawtooth');
            } else if (type === 'success') {
                contentEl.className = "bg-slate-900 border-2 border-emerald-500 text-slate-100 px-6 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3.5";
                iconEl.className = "fa-solid fa-circle-check text-emerald-400 text-2xl";
                playBuzzerBeep(1050, 0.1, 'sine');
            } else {
                contentEl.className = "bg-slate-900 border-2 border-blue-500 text-slate-100 px-6 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3.5";
                iconEl.className = "fa-solid fa-circle-info text-blue-400 text-2xl";
                playBuzzerBeep(880, 0.08, 'sine');
            }

            toast.classList.remove('-translate-y-24', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-24', 'opacity-0', 'pointer-events-none');
            }, 3200);
        }

        // Application State & Data
        let currentSystemState = 'boot'; // 'boot', 'app_select', 'mode_select', 'scanning', 'live_monitor', 'diagnostic'
        let selectedAppIndex = 0;
        const availableApplications = [
            { id: 'motor', name: 'Industrial Induction Motor', desc: 'Bearing Thermal & Vibration Diagnostics', icon: 'fa-gears' },
            { id: 'pump', name: 'Heavy-Duty Hydraulic Pump', desc: 'Pressure Cavitation & Line Flow Analysis', icon: 'fa-water' },
            { id: 'hvac', name: 'Commercial HVAC Compressor', desc: 'Refrigerant Loop & Temperature Monitoring', icon: 'fa-snowflake' }
        ];

        let selectedModeIndex = 0;
        const availableModes = [
            { id: 'live', name: 'Live Measurement Mode', desc: 'Real-time telemetry gauges and status LEDs', icon: 'fa-chart-line' },
            { id: 'diagnostic', name: 'Diagnostic Logging Mode', desc: 'Parallel SD record store with time stamps', icon: 'fa-sd-card' }
        ];

        let activeRecordFilter = 'ALL'; // 'ALL', 'NORMAL', 'ANOMALY', 'CRITICAL'
        let systemHealthState = 'NORMAL';
        let telemetryTimer = null;
        let scanTimer = null;

        let sensorTelemetry = {
            temperature: 42.0,
            humidity: 52.0,
            vibrationRMS: 1.2,
            sdState: 'IDLE', // 'IDLE' (Solid Green), 'SCANNING_WRITE' (Solid Red), 'EJECTED'
            recordLogs: [
                { id: 101, timestamp: '2026-10-16 10:14:02', temp: '41.2°C', vib: '1.1 mm/s', status: 'NORMAL', note: 'Normal Operation - All parameters within optimal thresholds.' },
                { id: 102, timestamp: '2026-10-16 10:18:45', temp: '68.5°C', vib: '3.9 mm/s', status: 'ANOMALY', note: 'Suspected Anomaly - Elevated vibration detected in bearings.' },
                { id: 103, timestamp: '2026-10-16 10:22:10', temp: '94.1°C', vib: '7.8 mm/s', status: 'CRITICAL', note: 'Critical Condition - Thermal threshold exceeded! Stop equipment.' }
            ]
        };

        // Real-Time Clock Sync (RTC DS3231 Simulation)
        setInterval(() => {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            const secs = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('rtc-clock').innerText = `${year}-${month}-${day} ${hours}:${mins}:${secs}`;
        }, 1000);

        // Keyboard Shortcut Handler (ESC for reboot)
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                triggerSystemReboot();
            } else if (e.key === 'ArrowUp') {
                handleKeypadAction('up');
            } else if (e.key === 'ArrowDown') {
                handleKeypadAction('down');
            } else if (e.key === 'Enter') {
                handleKeypadAction('select');
            } else if (e.key === 'Backspace') {
                handleKeypadAction('back');
            }
        });

        // Initialize App
        window.onload = function () {
            triggerSystemReboot();
        };

        // Step 1: Self-Diagnostic Boot POST Sequence
        function triggerSystemReboot() {
            if (telemetryTimer) clearInterval(telemetryTimer);
            if (scanTimer) clearTimeout(scanTimer);

            playBuzzerBeep(440, 0.15, 'sawtooth');
            setTimeout(() => playBuzzerBeep(880, 0.1, 'sine'), 180);

            currentSystemState = 'boot';
            selectedAppIndex = 0;
            selectedModeIndex = 0;
            systemHealthState = 'NORMAL';
            sensorTelemetry.sdState = 'IDLE';

            updatePWMDiagnosticLEDs('NORMAL');
            updateSDSlotVisuals();

            document.getElementById('screen-breadcrumb').innerText = "POST DIAGNOSTIC";
            document.getElementById('screen-app-tag').classList.add('hidden');
            document.getElementById('screen-status-msg').innerText = "SYS_BOOTING...";

            const screen = document.getElementById('screen-view');
            screen.innerHTML = `
                <div class="flex flex-col items-center justify-center space-y-4 w-full max-w-md text-center">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-400 flex items-center justify-center text-blue-400 text-2xl animate-pulse shadow-lg">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-mono font-bold tracking-wider text-slate-100">STM32 SMART INSTRUMENT</h2>
                        <p class="text-[11px] font-mono text-amber-400">Power-On Self Diagnostic Test (POST)</p>
                    </div>

                    <div class="w-full bg-slate-950/90 border border-slate-800 rounded-lg p-3 space-y-2 font-mono text-xs text-left" id="boot-log-container">
                        <div class="text-blue-400 flex items-center gap-2"><i class="fa-solid fa-spinner animate-spin"></i> Initializing System Peripherals...</div>
                    </div>
                </div>
            `;

            const bootItems = [
                "Testing TFT Display Controller (ILI9341)... [ OK ]",
                "Checking Temperature Sensor (TMP36)... [ OK ]",
                "Checking Relative Humidity Sensor (DHT22)... [ OK ]",
                "Checking Vibration Sensor (ADXL335)... [ OK ]",
                "Mounted SD Card FAT32 File System... [ OK ]",
                "Synchronizing RTC Time Stamp (DS3231)... [ OK ]",
                "Self-Diagnostic Passed. System Initialized."
            ];

            let step = 0;
            const logBox = document.getElementById('boot-log-container');

            const bootInterval = setInterval(() => {

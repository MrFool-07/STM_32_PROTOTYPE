        function startScanningAndLoggingSequence() {
            currentSystemState = 'scanning';
            sensorTelemetry.sdState = 'SCANNING_WRITE';
            updateSDSlotVisuals(); // LED turns SOLID RED (No blinking)

            document.getElementById('screen-breadcrumb').innerText = "ACQUIRING & WRITING SD";
            document.getElementById('screen-status-msg').innerText = "SD_WRITE_BUSY";

            const screen = document.getElementById('screen-view');
            screen.innerHTML = `
                <div class="flex flex-col items-center justify-center space-y-4 w-full max-w-md text-center">
                    <div class="w-14 h-14 rounded-full bg-red-500/20 border-2 border-red-500 flex items-center justify-center text-red-500 text-2xl">
                        <i class="fa-solid fa-sd-card"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-mono font-bold text-slate-100">Acquiring Sensor Signals & Logging Data...</h3>
                        <p class="text-[11px] font-mono text-red-400 font-bold mt-1">SD LED: SOLID RED • DO NOT EJECT CARD</p>
                    </div>

                    <!-- Scan Progress Bar -->
                    <div class="w-full bg-slate-950 h-3 rounded-full overflow-hidden border border-slate-800 p-0.5">
                        <div id="scan-progress" class="bg-red-500 h-full rounded-full transition-all duration-300" style="width: 5%"></div>
                    </div>

                    <div class="text-[10px] font-mono text-slate-400" id="scan-status-text">Sampling ADXL335 & TMP36 sensors...</div>
                </div>
            `;

            let progress = 5;
            const progressBar = document.getElementById('scan-progress');
            const statusText = document.getElementById('scan-status-text');

            const scanInterval = setInterval(() => {
                progress += 20;
                if (progressBar) progressBar.style.width = Math.min(100, progress) + '%';

                if (progress === 45) {
                    if (statusText) statusText.innerText = "Writing telemetry frame to SD FAT32 sector...";
                    playBuzzerBeep(750, 0.05);
                } else if (progress === 85) {
                    if (statusText) statusText.innerText = "Appending timestamp entry to LOG_DATA.CSV...";
                    playBuzzerBeep(850, 0.05);
                }

                if (progress >= 100) {
                    clearInterval(scanInterval);

                    // Add new recorded log
                    const now = new Date();
                    const year = now.getFullYear();
                    const month = String(now.getMonth() + 1).padStart(2, '0');
                    const day = String(now.getDate()).padStart(2, '0');
                    const hours = String(now.getHours()).padStart(2, '0');
                    const mins = String(now.getMinutes()).padStart(2, '0');
                    const secs = String(now.getSeconds()).padStart(2, '0');
                    const timestampStr = `${year}-${month}-${day} ${hours}:${mins}:${secs}`;

                    let plainEnglishNote = "Normal Operation - All parameters within optimal thresholds.";
                    if (systemHealthState === 'ANOMALY') plainEnglishNote = "Suspected Anomaly - Elevated vibration detected in bearings.";
                    if (systemHealthState === 'CRITICAL') plainEnglishNote = "Critical Condition - Thermal threshold exceeded! Stop equipment.";

                    sensorTelemetry.recordLogs.unshift({
                        id: 100 + sensorTelemetry.recordLogs.length + 1,
                        timestamp: timestampStr,
                        temp: `${sensorTelemetry.temperature}°C`,
                        vib: `${sensorTelemetry.vibrationRMS} mm/s`,
                        status: systemHealthState,
                        note: plainEnglishNote
                    });

                    // SD write finished -> Turn LED SOLID GREEN
                    sensorTelemetry.sdState = 'IDLE';
                    updateSDSlotVisuals();
                    playBuzzerBeep(1200, 0.15, 'sine');

                    if (selectedModeIndex === 0) {
                        renderLiveDashboard();
                    } else {
                        renderDiagnosticDashboard();
                    }
                }
            }, 250);
        }


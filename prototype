                <div class="flex justify-between items-center border-b border-slate-800 pb-1.5">
                    <span class="text-xs font-mono font-bold text-slate-200 tracking-wide flex items-center gap-1.5">
                        <i class="fa-solid fa-gamepad text-blue-400"></i> MODE SWITCH KEYPAD

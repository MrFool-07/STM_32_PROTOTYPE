<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STM32 Smart Data Acquisition & Diagnostic Instrument</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --chassis-bg: #111827;
            --bezel-border: #f59e0b;
            --screen-bg: #0b132b;
            --accent-yellow: #f59e0b;
            --accent-blue: #2563eb;
            --accent-red: #ef4444;
            --accent-green: #10b981;
        }

        body {
            background-color: #030712;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
        }

        .instrument-chassis {
            background: linear-gradient(145deg, #1f2937, #111827);
            border: 3px solid #374151;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .tft-display {
            background: radial-gradient(circle at center, #0d1b2a 0%, #050c1a 100%);
            border: 2px solid #2563eb;
            box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.9), 0 0 10px rgba(37, 99, 235, 0.2);
        }

        /* Tactile Enclosure Screws */
        .chassis-screw {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6b7280 0%, #1f2937 100%);
            box-shadow: inset 1px 1px 1px rgba(255, 255, 255, 0.3), 0 1px 2px rgba(0, 0, 0, 0.8);
            position: relative;
        }

        .chassis-screw::before {
            content: '';
            position: absolute;
            top: 4px;
            left: 1px;
            width: 8px;
            height: 2px;
            background: #111827;
            transform: rotate(45deg);
        }

        /* Tactile Keypad Buttons */
        .btn-keypad {
            background: linear-gradient(180deg, #374151 0%, #1f2937 100%);
            border: 1px solid #4b5563;
            box-shadow: 0 3px 0 #111827, 0 4px 6px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transition: all 0.08s ease;
        }

        .btn-keypad:active,
        .btn-keypad.active-press {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #111827, 0 2px 3px rgba(0, 0, 0, 0.5);
        }

        /* Solid High-Precision PWM LEDs */
        .led-off {
            background-color: #1e293b;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.8);
            opacity: 0.3;
        }

        .led-solid-green {
            background-color: #10b981;
            box-shadow: 0 0 12px #10b981, inset 0 1px 2px #ffffff;
            opacity: 1;
        }

        .led-solid-yellow {
            background-color: #f59e0b;
            box-shadow: 0 0 12px #f59e0b, inset 0 1px 2px #ffffff;
            opacity: 1;
        }

        .led-solid-red {
            background-color: #ef4444;
            box-shadow: 0 0 14px #ef4444, inset 0 1px 2px #ffffff;
            opacity: 1;
            /* Solid red, strictly non-blinking */
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
        }

        ::-webkit-scrollbar-thumb {
            background: #2563eb;
            border-radius: 3px;
        }
    </style>
</head>

<body class="h-full flex flex-col items-center justify-center p-2 sm:p-4 select-none" id="app-root">

    <!-- Warning / Notification Toast Modal -->
    <div id="toast-modal"
        class="fixed top-5 z-50 transform -translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toast-content"
            class="bg-slate-900 border-2 border-red-500 text-slate-100 px-6 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3.5">
